# plot.color — colours, categorical palettes, and continuous colormaps for plotting.
#
# `import plot.color as color`.
#
# Pure data + interpolation, no device: a Color is four floats in [0, 1]; a categorical palette is
# a `list<Color>` cycled by series index; a colormap maps t in [0, 1] to a Color by linear
# interpolation through a small anchor table (the classic perceptual maps ship as anchors). An
# alpha of exactly 0 is the "auto" sentinel the figure layer resolves to the next palette colour.
# (The API spec sketched palettes as `ndarray<Color>`; cheatah's ndarray holds numeric fields, so
# the purr-native `list<Color>` is the honest container.)

import math

# One RGBA colour, channels in [0, 1]. Alpha exactly 0 means "auto: take the next palette colour".
struct Color {
    r : float   # red in [0, 1].
    g : float   # green in [0, 1].
    b : float   # blue in [0, 1].
    a : float   # alpha in [0, 1]; exactly 0 = the auto sentinel.
}

# An opaque colour from red/green/blue channels.
#
# @param r red in [0, 1].
# @param g green in [0, 1].
# @param b blue in [0, 1].
# @return the opaque Color (alpha 1).
# @complexity O(1).
# @alloc the Color.
# @systest systests/test_color.purr
# @par Example
# @code{.purr}
# import plot.color as color
# let steel = color.rgb(0.275, 0.510, 0.706)
# let a = steel.a   # -> 1.0: rgb always builds an opaque colour
# @endcode
fn rgb(r : float, g : float, b : float) -> Color {
    return Color({.r = r, .g = g, .b = b, .a = 1.0})
}

# A colour from all four channels. Note alpha exactly 0 is reserved as the auto sentinel — a fully
# transparent DRAWN colour is not representable (use a tiny alpha instead; nothing visible changes).
#
# @param r red in [0, 1].
# @param g green in [0, 1].
# @param b blue in [0, 1].
# @param a alpha in [0, 1].
# @return the Color.
# @complexity O(1).
# @alloc the Color.
# @systest systests/test_color.purr
# @par Example
# @code{.purr}
# import plot.color as color
# let band = color.rgba(0.122, 0.467, 0.706, 0.25)
# let a = band.a   # -> 0.25: a translucent blue for bands and fills
# @endcode
fn rgba(r : float, g : float, b : float, a : float) -> Color {
    return Color({.r = r, .g = g, .b = b, .a = a})
}

# The "auto" colour sentinel: alpha 0. A Series carrying it gets the next palette colour when the
# figure resolves styles.
#
# @return the transparent auto sentinel.
# @complexity O(1).
# @alloc the Color.
# @systest systests/test_color.purr
# @par Example
# @code{.purr}
# import plot.color as color
# let c = color.auto_color()
# let a = color.is_auto(c)   # -> true: the figure will assign the next palette colour
# @endcode
fn auto_color() -> Color {
    return Color({.r = 0.0, .g = 0.0, .b = 0.0, .a = 0.0})
}

# Whether @p c is the auto sentinel (alpha exactly 0) — the test the figure layer runs before
# assigning palette colours.
#
# @param c the colour to inspect.
# @return true when @p c means "auto".
# @complexity O(1).
# @alloc none.
# @systest systests/test_color.purr
# @par Example
# @code{.purr}
# import plot.color as color
# let c = color.named("tomato")
# let a = color.is_auto(c)   # -> false: an explicit colour is kept as-is
# @endcode
fn is_auto(c : Color) -> bool {
    return c.a == 0.0
}

# Linear interpolation between two colours, channel-wise (alpha included), with @p t clamped to
# [0, 1] — the primitive every colormap is built from.
#
# @param c0 the colour at t = 0.
# @param c1 the colour at t = 1.
# @param t the blend position (clamped to [0, 1]).
# @return the blended Color.
# @complexity O(1).
# @alloc the Color.
# @systest systests/test_color.purr
# @par Example
# @code{.purr}
# import plot.color as color
# let blue = color.rgb(0.0, 0.0, 1.0)
# let red = color.rgb(1.0, 0.0, 0.0)
# let mid = color.lerp(blue, red, 0.5)   # -> the even blend (r 0.5, b 0.5)
# @endcode
fn lerp(c0 : Color, c1 : Color, t : float) -> Color {
    let u = t
    if u < 0.0 { u = 0.0 }
    if u > 1.0 { u = 1.0 }
    return Color({.r = c0.r + (c1.r - c0.r) * u,
                  .g = c0.g + (c1.g - c0.g) * u,
                  .b = c0.b + (c1.b - c0.b) * u,
                  .a = c0.a + (c1.a - c0.a) * u})
}

# Sample an anchor table at @p t in [0, 1]: the anchors are treated as evenly spaced stops and the
# two neighbours of @p t are blended. Out-of-range @p t clamps; an empty table returns opaque black.
#
# @param anchors the colour stops, evenly spaced across [0, 1].
# @param t the sample position (clamped to [0, 1]).
# @return the interpolated Color.
# @complexity O(1).
# @alloc the Color.
# @systest systests/test_color.purr
# @par Example
# @code{.purr}
# import plot.color as color
# import Color from plot.color
# let anchors : list<Color> = []
# anchors.append(color.rgb(0.0, 0.0, 0.5))
# anchors.append(color.rgb(1.0, 1.0, 0.0))
# let mid = color.sample(anchors, 0.5)   # -> halfway between the two stops
# @endcode
fn sample(anchors : list<Color>, t : float) -> Color {
    let n = len(anchors)
    if n == 0 {
        return rgb(0.0, 0.0, 0.0)
    }
    if n == 1 {
        return anchors[0]
    }
    let u = t
    if u < 0.0 { u = 0.0 }
    if u > 1.0 { u = 1.0 }
    let pos = u * float(n - 1)
    let i = int(math.floor(pos))
    if i >= n - 1 {
        return anchors[n - 1]
    }
    return lerp(anchors[i], anchors[i + 1], pos - float(i))
}

# The viridis colormap (dark violet -> teal -> yellow), sampled at @p t — perceptually uniform and
# colour-blind friendly; the default for continuous data.
#
# @param t the sample position in [0, 1] (clamped).
# @return the Color at @p t.
# @complexity O(1).
# @alloc the Color (plus the transient anchor table).
# @systest systests/test_color.purr
# @par Example
# @code{.purr}
# import plot.color as color
# let lo = color.viridis(0.0)   # -> dark violet
# let hi = color.viridis(1.0)   # -> bright yellow
# @endcode
fn viridis(t : float) -> Color {
    let anchors : list<Color> = []
    anchors.append(rgb(0.267, 0.005, 0.329))
    anchors.append(rgb(0.231, 0.322, 0.545))
    anchors.append(rgb(0.129, 0.567, 0.549))
    anchors.append(rgb(0.369, 0.788, 0.384))
    anchors.append(rgb(0.993, 0.906, 0.144))
    return sample(anchors, t)
}

# The magma colormap (black -> purple -> orange -> pale yellow), sampled at @p t.
#
# @param t the sample position in [0, 1] (clamped).
# @return the Color at @p t.
# @complexity O(1).
# @alloc the Color (plus the transient anchor table).
# @systest systests/test_color.purr
# @par Example
# @code{.purr}
# import plot.color as color
# let lo = color.magma(0.0)    # -> near black
# let hi = color.magma(0.75)   # -> warm orange
# @endcode
fn magma(t : float) -> Color {
    let anchors : list<Color> = []
    anchors.append(rgb(0.001, 0.000, 0.016))
    anchors.append(rgb(0.316, 0.071, 0.485))
    anchors.append(rgb(0.716, 0.215, 0.475))
    anchors.append(rgb(0.987, 0.535, 0.382))
    anchors.append(rgb(0.988, 0.998, 0.749))
    return sample(anchors, t)
}

# The coolwarm diverging colormap (blue -> pale grey -> red), sampled at @p t — for data with a
# meaningful midpoint (deviations, correlations).
#
# @param t the sample position in [0, 1] (clamped).
# @return the Color at @p t.
# @complexity O(1).
# @alloc the Color (plus the transient anchor table).
# @systest systests/test_color.purr
# @par Example
# @code{.purr}
# import plot.color as color
# let below = color.coolwarm(0.0)   # -> blue: under the midpoint
# let mid = color.coolwarm(0.5)     # -> pale grey: the meaningful middle
# @endcode
fn coolwarm(t : float) -> Color {
    let anchors : list<Color> = []
    anchors.append(rgb(0.230, 0.299, 0.754))
    anchors.append(rgb(0.865, 0.865, 0.865))
    anchors.append(rgb(0.706, 0.016, 0.150))
    return sample(anchors, t)
}

# The 10-colour categorical palette series colours cycle through (the familiar matplotlib-style
# tab10 wheel: blue, orange, green, red, violet, brown, pink, grey, olive, cyan).
#
# @return the 10 opaque categorical colours, in cycling order.
# @complexity O(1).
# @alloc the returned list.
# @systest systests/test_color.purr
# @par Example
# @code{.purr}
# import plot.color as color
# let wheel = color.tab10()
# let second = wheel[1]   # -> the tab10 orange (series index 1)
# @endcode
fn tab10() -> list<Color> {
    let p : list<Color> = []
    p.append(rgb(0.122, 0.467, 0.706))
    p.append(rgb(1.000, 0.498, 0.055))
    p.append(rgb(0.173, 0.627, 0.173))
    p.append(rgb(0.839, 0.153, 0.157))
    p.append(rgb(0.580, 0.404, 0.741))
    p.append(rgb(0.549, 0.337, 0.294))
    p.append(rgb(0.890, 0.467, 0.761))
    p.append(rgb(0.498, 0.498, 0.498))
    p.append(rgb(0.737, 0.741, 0.133))
    p.append(rgb(0.090, 0.745, 0.812))
    return p
}

# A categorical palette by name: "tab10" (default) or "dark" (tab10 darkened for light
# backgrounds). Unknown names return tab10 — a plot always gets usable colours.
#
# @param name the palette name.
# @return the palette colours, in cycling order.
# @complexity O(1).
# @alloc the returned list.
# @systest systests/test_color.purr
# @par Example
# @code{.purr}
# import plot.color as color
# let dark = color.palette("dark")
# let first = dark[0]   # -> tab10 blue, darkened for light backgrounds
# @endcode
fn palette(name : str) -> list<Color> {
    if name == "dark" {
        let base = tab10()
        let p : list<Color> = []
        for i in range(len(base)) {
            let c = base[i]
            p.append(rgb(c.r * 0.72, c.g * 0.72, c.b * 0.72))
        }
        return p
    }
    return tab10()
}

# A colour from a small CSS-style name table (the everyday names: black, white, red, green, blue,
# orange, purple, brown, pink, gray, cyan, magenta, gold, teal, steelblue, crimson, forestgreen,
# darkorange, royalblue, tomato, slategray). Unknown names return opaque black.
#
# @param name the colour name (lowercase).
# @return the named Color (opaque black when unknown).
# @complexity O(1).
# @alloc the Color.
# @systest systests/test_color.purr
# @par Example
# @code{.purr}
# import plot.color as color
# let stroke = color.named("crimson")
# let accent = color.named("gold")   # -> everyday colours for the _styled marks
# @endcode
fn named(name : str) -> Color {
    if name == "white" { return rgb(1.0, 1.0, 1.0) }
    if name == "red" { return rgb(1.0, 0.0, 0.0) }
    if name == "green" { return rgb(0.0, 0.502, 0.0) }
    if name == "blue" { return rgb(0.0, 0.0, 1.0) }
    if name == "orange" { return rgb(1.0, 0.647, 0.0) }
    if name == "purple" { return rgb(0.502, 0.0, 0.502) }
    if name == "brown" { return rgb(0.647, 0.165, 0.165) }
    if name == "pink" { return rgb(1.0, 0.753, 0.796) }
    if name == "gray" { return rgb(0.502, 0.502, 0.502) }
    if name == "cyan" { return rgb(0.0, 1.0, 1.0) }
    if name == "magenta" { return rgb(1.0, 0.0, 1.0) }
    if name == "gold" { return rgb(1.0, 0.843, 0.0) }
    if name == "teal" { return rgb(0.0, 0.502, 0.502) }
    if name == "steelblue" { return rgb(0.275, 0.510, 0.706) }
    if name == "crimson" { return rgb(0.863, 0.078, 0.235) }
    if name == "forestgreen" { return rgb(0.133, 0.545, 0.133) }
    if name == "darkorange" { return rgb(1.0, 0.549, 0.0) }
    if name == "royalblue" { return rgb(0.255, 0.412, 0.882) }
    if name == "tomato" { return rgb(1.0, 0.388, 0.278) }
    if name == "slategray" { return rgb(0.439, 0.502, 0.565) }
    return rgb(0.0, 0.0, 0.0)
}
