# systests/test_plot_render_pixels — figure state invariants the renderer relies on: limits
# override auto, sizes clamp, palettes cycle — the model contract under the pixels.

import io
import ndarray
import plot.figure as figure
import plot.color as color
import check

io.print("== plot: render-facing model invariants ==")
let f = 0

let x = ndarray.array([0.0, 1.0])
let y = ndarray.array([0.0, 1.0])
let fig = figure.line(figure.new_figure(), x, y)

# Fixed limits override auto (NaN) limits.
fig = figure.xlim(fig, -5.0, 5.0)
f += check.is_true("xlim lo", fig.subplots[0].x.lo == -5.0)
f += check.is_true("xlim hi", fig.subplots[0].x.hi == 5.0)

# The size floor keeps the framebuffer drawable.
let tiny = figure.size(fig, 1, 1)
f += check.eq_int("width floor", tiny.width, 64)
f += check.eq_int("height floor", tiny.height, 64)

# The default palette cycles ten distinct colours.
let pal = color.tab10()
f += check.eq_int("palette size", len(pal), 10)
let c0 = pal[0]
let c1 = pal[1]
f += check.is_true("palette distinct", c0.r != c1.r)

check.result(f)
